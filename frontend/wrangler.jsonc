// Cloudflare Workers: static files, plus one function for /api/* (worker/index.ts: Wel3a's
// chat on Workers AI). Build first, with the API's URL:
//   NEXT_PUBLIC_API_URL=https://almatafi-api.monitorthesituations.com npm run build
//   npx wrangler@4.156.2 deploy
// GitHub Actions does both on every merge to main (.github/workflows/deploy.yml).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "almatafi",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Everything else is served from out/ without running (or counting) the Worker.
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  // Per visitor IP and Cloudflare location: 50 questions a minute.
  "ratelimits": [{ "name": "WEL3A_LIMIT", "namespace_id": "1001", "simple": { "limit": 50, "period": 60 } }],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "workers_dev": true,
  "routes": [{ "pattern": "almatafi.monitorthesituations.com", "custom_domain": true }]
}
