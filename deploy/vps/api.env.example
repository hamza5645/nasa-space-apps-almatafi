# Backend settings on the VPS. install.sh copies this to ~almatafi/.config/almatafi/api.env
# (mode 600) the first time; edit that copy, never commit real values.
ALMATAFI_CORS_ORIGINS=https://almatafi.monitorthesituations.com,https://almatafi.hamzaosama5645.workers.dev,http://localhost:3000
# NRT layer and on-demand hotspots; empty switches them off.
FIRMS_MAP_KEY=
# A way to reach us, sent to Nominatim in the User-Agent (its usage policy).
ALMATAFI_CONTACT=https://github.com/khalidstark/nasa-space-apps-modis
# Real data bundle (from Nov 13, backend/app/bootstrap.py); empty = the mock data in the image.
ALMATAFI_DATA_URL=
ALMATAFI_DATA_SHA256=
