{
  "name": "almatafi-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "node scripts/copy-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test lib/*.test.ts lib/orbit/*.test.ts",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o lib/api-types.ts --default-non-nullable false",
    "cache": "node scripts/copy-cache.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.3",
    "echarts": "6.1.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "maplibre-gl": "6.16.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "terra-draw": "1.39.0",
    "terra-draw-maplibre-gl-adapter": "1.5.0",
    "three": "0.187.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
